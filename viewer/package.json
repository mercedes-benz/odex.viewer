{
  "name": "odex.viewer-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "api-client-gen": "openapi-typescript ../diag-server.yml -o ./api/diag-server.d.ts",
    "build": "next build",
    "serve-static": "serve out",
    "lint": "eslint . --ext .ts,.tsx -c .eslintrc.json --fix",
    "test:dev": "playwright test --workers=1 --config=playwright.config-dev.ts",
    "test": "playwright test",
    "test:ts": "tsc --noEmit",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@heroui/accordion": "2.2.29",
    "@heroui/alert": "2.2.32",
    "@heroui/breadcrumbs": "2.2.25",
    "@heroui/button": "2.2.32",
    "@heroui/card": "2.2.28",
    "@heroui/chip": "2.2.25",
    "@heroui/code": "2.2.25",
    "@heroui/dropdown": "2.3.32",
    "@heroui/input": "2.4.33",
    "@heroui/kbd": "2.2.26",
    "@heroui/link": "2.2.26",
    "@heroui/listbox": "2.3.31",
    "@heroui/navbar": "2.2.30",
    "@heroui/pagination": "2.2.27",
    "@heroui/popover": "2.3.32",
