{
  "name": "odex.viewer-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "api-client-gen": "openapi-typescript ../diag-server.yml -o ./api/diag-server.d.ts",
    "build": "next build",
    "serve-static": "serve out",
    "lint": "eslint . --ext .ts,.tsx -c .eslintrc.json --fix",
    "test:dev": "playwright test --workers=1 --config=playwright.config-dev.ts",
    "test": "playwright test",
    "test:ts": "tsc --noEmit",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@heroui/accordion": "2.2.22",
    "@heroui/alert": "2.2.25",
    "@heroui/breadcrumbs": "2.2.15",
    "@heroui/button": "2.2.25",
    "@heroui/card": "2.2.24",
    "@heroui/chip": "2.2.21",
    "@heroui/code": "2.2.19",
    "@heroui/dropdown": "2.3.25",
    "@heroui/input": "2.4.26",
    "@heroui/kbd": "2.2.20",
    "@heroui/link": "2.2.22",
    "@heroui/listbox": "2.3.24",
    "@heroui/navbar": "2.2.23",
    "@heroui/pagination": "2.2.23",
    "@heroui/popover": "2.3.25",
