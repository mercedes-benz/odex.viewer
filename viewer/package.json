    "@heroui/system": "2.4.21",
    "@heroui/table": "2.2.25",
    "@heroui/tabs": "2.2.22",
    "@heroui/theme": "2.4.21",
    "@react-aria/ssr": "3.9.10",
    "@react-aria/visually-hidden": "3.8.27",
    "@react-stately/data": "^3.12.3",
    "chart.js": "^4.5.1",
    "clsx": "2.1.1",
    "cytoscape": "^3.33.1",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "12.6.1",
    "html-react-parser": "^5.2.5",
    "intl-messageformat": "^10.7.16",
    "katex": "0.16.22",
    "lodash-es": "4.17.23",
    "next": "^15.5.2",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.13.5",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.0.0",
    "swr": "^2.3.3",
    "swr-openapi": "^5.1.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.2",
    "@playwright/test": "^1.58.2",
    "@react-types/shared": "3.30.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/katex": "0.16.7",
    "@types/lodash-es": "4.17.12",
    "@types/node": "20.5.7",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "8.28.0",
    "@typescript-eslint/parser": "8.28.0",
    "autoprefixer": "10.4.21",
    "axios": "^1.8.4",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.2",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "openapi-typescript": "^7.5.2",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "serve": "^14.2.5",
    "tailwind-variants": "3.1.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --cache-location .next/cache/eslint/ --config .eslintrc.json --fix"
    ],
    "*.{js,jsx,ts,tsx,css,scss,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
