    "@heroui/switch": "2.2.27",
    "@heroui/system": "2.4.28",
    "@heroui/table": "2.2.32",
    "@heroui/tabs": "2.2.29",
    "@heroui/theme": "2.4.26",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/visually-hidden": "3.9.1",
    "@react-stately/data": "^3.16.1",
    "chart.js": "^4.5.1",
    "clsx": "2.1.1",
    "cytoscape": "^3.34.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "12.40.0",
    "html-react-parser": "^6.1.3",
    "intl-messageformat": "^11.2.8",
    "katex": "0.17.0",
    "lodash-es": "4.18.1",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.7",
    "swr": "^2.4.1",
    "swr-openapi": "^5.6.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@react-types/shared": "3.35.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/katex": "0.16.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "autoprefixer": "10.5.0",
    "axios": "^1.17.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "serve": "^14.2.5",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --cache-location .next/cache/eslint/ --config .eslintrc.json --fix"
    ],
    "*.{js,jsx,ts,tsx,css,scss,md,yml,yaml}": "prettier --write --ignore-unknown"
  }
