{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate JSON Schemas and OpenAPI code",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/export_openapi_models.py",
      "console": "integratedTerminal",
      "postDebugTask": "generateOpenApiCode"
    },
    {
      "name": "Cleanup and regenerate OpenAPI code",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/scripts/clear_openapi_gen_folders.py",
      "console": "integratedTerminal",
      "postDebugTask": "generateOpenApiCode"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Upload PDX files",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server/upload_pdx_file.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Start Server",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "module": "diag_server.openapi_server",
      "justMyCode": false
    },
    {
      "name": "Start Server/Open Browser",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "module": "diag_server.openapi_server",
      "justMyCode": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "running on http://0.0.0.0:([0-9]+)",
        "uriFormat": "http://localhost:%s/v1/ui",
        "killOnServerStop": true
      }
    },
    {
      "name": "Start Server via Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "module": "uvicorn",
      "args": [
        "diag_server.gunicorn_app:server_app",
        "--reload",
        "--port",
        "8080"
      ],
      "justMyCode": false
    },
    {
      "name": "Start Viewer",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/viewer",
      "command": "npm run dev",
      "sourceMaps": true
    },
    {
      "name": "Start Viewer/Open Browser",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/viewer",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/viewer",
        "killOnServerStop": true
      },
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Start Server with Data",
      "configurations": ["Start Server/Open Browser", "Upload PDX files"],
      "stopAll": true
    },
    {
      "name": "Start Viewer and Server",
      "configurations": ["Start Server via Uvicorn", "Start Viewer/Open Browser"],
      "stopAll": true
    }
  ]
}
